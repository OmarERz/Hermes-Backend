# Hermes backend configuration (docs/11 §2). Copy to .env and fill in; never commit real values.
# In production mount them as Docker secrets (/run/secrets/<variable_name_in_lower_case>).
# The setup wizard never captures keys: it checks each connection and reports what is missing (D-042).

# --- Required to start ---
# PostgreSQL connection URL (the app role, not migrator)
DATABASE_URL=postgresql://app:change-me@db:5432/hermes
# Firebase project that issues the ID tokens. demo-hermes works with the Auth emulator only.
FIREBASE_PROJECT_ID=demo-hermes
# Secret that signs pagination cursors (HMAC-SHA256, API-02); at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates cursors already issued (clients just restart the listing).
CURSOR_SIGNING_KEY=change-me-use-at-least-32-random-characters

# Passwords of the local PostgreSQL (DAT-05): the superuser and the login roles; Alembic runs as migrator, API and
# workers as app. With docker compose they become Docker secret files: run `make compose-secrets` (it also writes
# the optional API keys below, blank means "not configured") before `docker compose up`.
POSTGRES_PASSWORD=change-me
MIGRATOR_DB_PASSWORD=change-me-too
APP_DB_PASSWORD=change-me-as-well
RETENTION_DB_PASSWORD=change-me-also

# --- Firebase Admin SDK (most sensitive secret; path to the service account JSON) ---
FIREBASE_CREDENTIALS_FILE=
# Local Auth emulator (compose sets it to auth-emulator:9099 for the containers; tests only)
FIREBASE_AUTH_EMULATOR_HOST=

# Swagger UI at /api/docs and /api/openapi.json, development only (off by default)
API_DOCS_ENABLED=false
# includeSubDomains in HSTS: only when the API has its own host name (README §7)
HSTS_INCLUDE_SUBDOMAINS=false

# Exact browser origins allowed to call the API cross-origin (the React front on another origin), comma-separated,
# e.g. https://hermes-front.example.com,http://localhost:5173. Empty = same origin only (front and API behind one
# reverse proxy). Wildcards are refused.
CORS_ALLOWED_ORIGINS=

# Addresses Uvicorn trusts for X-Forwarded-For (read by Uvicorn itself): the reverse proxy's, so the logs show the real
# client IP. Never * while the API port is reachable without the proxy. Compose defaults it to 127.0.0.1.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- iTop REST API ---
ITOP_URL=
# The iTop console people open from the links of the front and the notifications; blank = ITOP_URL. Set it when
# ITOP_URL is a name only the containers resolve (http://itop:8080 on the shared network), e.g. http://127.0.0.1:8080
ITOP_CONSOLE_URL=
ITOP_TOKEN=
# iTop user the system creates tickets with (tells system changes from human ones, D-007). Every write sends it as
# the REST `comment`, which iTop records as the change's userinfo; blank = "Hermes"
ITOP_SYSTEM_USER=
# Shared secret iTop's webhook sends as "Authorization: Bearer" (ARQ-02); empty = webhook disabled (503)
ITOP_WEBHOOK_TOKEN=
# Who files tickets (D-036): iTop ids of the organization, the system person (caller) and the service.
# Without ITOP_ORG_ID and ITOP_CALLER_ID the pipeline scores but opens no tickets.
ITOP_ORG_ID=
ITOP_CALLER_ID=
ITOP_SERVICE_ID=

# --- Pipeline ---
# Scheduled simulated scan every N hours; 0 = only on demand (POST /api/scans)
SCAN_INTERVAL_HOURS=0
# Embeddings service on the internal Compose network (docker/embeddings); blank = the news cycle is off
EMBEDDINGS_URL=http://embeddings:8080

# --- Vulnerability and threat sources ---
NVD_API_KEY=
ABUSECH_AUTH_KEY=
RANSOMWARELIVE_API_KEY=

# --- LLM (OpenAI-compatible API) ---
DEEPSEEK_API_KEY=
# Defaults to https://api.deepseek.com/beta (strict tool mode)
LLM_BASE_URL_JUDGE=
# Defaults to LLM_BASE_URL_JUDGE; http://localhost:11434/v1 for a local Ollama model
LLM_BASE_URL_ANALYSTS=

# --- LLM provider (D-084) ---
# deepseek (default: the OpenAI-compatible API above) or claude-code: the Claude Code CLI with your Claude subscription
# (`claude` on PATH and logged in, `claude auth status`). claude-code works only for a worker run on this machine
# (`make worker-host`): the CLI and its login are not in the containers, where the analysts and the judge stay off.
# It needs no DEEPSEEK_API_KEY and never uses ANTHROPIC_API_KEY (the CLI gets a minimal environment).
LLM_PROVIDER=
# Claude Code model of each role: an alias (opus, sonnet) or a full model name. Defaults: opus and sonnet.
CLAUDE_CODE_MODEL_JUDGE=
CLAUDE_CODE_MODEL_ANALYSTS=
# Effort of every call: low, medium, high, xhigh or max. Default medium.
CLAUDE_CODE_EFFORT=
# Seconds one CLI call may take (30 to 3600). Default 300.
CLAUDE_CODE_TIMEOUT_SECONDS=

# --- CVE analyst ---
# Hosts the vendor advisory text may be downloaded from (D-014); a domain also allows its subdomains.
# Unset: the default list approved by the user (docs/02 section 4). Set and empty: no advisory is downloaded.
# ADVISORY_DOMAINS=msrc.microsoft.com,support.apple.com,access.redhat.com,ubuntu.com,debian.org,security.debian.org,oracle.com,sec.cloudapps.cisco.com,security.paloaltonetworks.com,fortiguard.com,helpx.adobe.com,openssl.org,kb.vmware.com,support.broadcom.com

# --- Local stack (docker compose interpolation; defaults shown) ---
# Host ports published on 127.0.0.1, and where `make compose-secrets` writes the secret files.
# API_PORT=8000
# DB_PORT=5432
# AUTH_EMULATOR_PORT=9099
# COMPOSE_SECRETS_DIR=./.compose-secrets
# Port of the embeddings service on 127.0.0.1, published only for a worker on this machine (`make worker-host`)
# EMBEDDINGS_PORT=8081
# Admin CLI outside compose (`make seed`): the migrator role, e.g. postgresql://migrator@127.0.0.1:5432/hermes
# MIGRATION_DATABASE_URL=

# --- Persistent iTop (compose.itop.yaml, README section 9) ---
# Its passwords are secret files that `make itop-secrets` generates; nothing about them goes here.
# Console port on 127.0.0.1 and where iTop's webhook calls the API (on the shared network: the api service).
# ITOP_PORT=8080
# ITOP_WEBHOOK_URL=http://api:8000/api/itop/webhook
# Put the api and the workers on the network shared with iTop (after `make itop-link`), so ITOP_URL=http://itop:8080
# COMPOSE_FILE=compose.yaml:compose.itop-link.yaml

# The Slack module (other team, NOT-07) brings SLACK_BOT_TOKEN and SLACK_APP_TOKEN when it is integrated (F11).
