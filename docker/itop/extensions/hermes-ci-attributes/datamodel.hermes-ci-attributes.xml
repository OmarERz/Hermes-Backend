  <user_rights>
    <profiles>
      <!-- Least privilege for the backend (C16): read everything, write only tickets and their links. -->
      <profile id="100" _delta="define">
        <name>Hermes Backend</name>
        <description>Reads the CMDB, creates and updates the security tickets of Hermes and reopens them</description>
        <groups>
          <group id="Ticketing">
            <actions>
              <action id="action:write">allow</action>
            </actions>
          </group>
          <group id="UserRequest">
            <actions>
              <action id="action:write">allow</action>
              <action id="action:bulk write">allow</action>
              <!-- The only stimulus the backend sends (outbox STIMULI): people assign, resolve and close in the console.
                   iTop checks stimulus grants in the console only: its REST core/apply_stimulus asks for write and
                   bulk write on the class (so both stay), and the outbox allowlist keeps the backend to ev_reopen. -->
              <action id="stimulus:ev_reopen">allow</action>
            </actions>
          </group>
          <group id="*">
            <actions>
              <action id="action:read">allow</action>
              <action id="action:bulk read">allow</action>
            </actions>
          </group>
        </groups>
      </profile>
    </profiles>
  </user_rights>
