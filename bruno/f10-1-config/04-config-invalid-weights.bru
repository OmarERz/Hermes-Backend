meta {
  name: config-invalid-weights
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/config
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  // The current version, so the weights rule (422) is reached instead of the version check (409, API-03).
  const current = await bru.sendRequest({
    method: "GET",
    url: `${bru.getEnvVar("baseUrl")}/api/config`,
    headers: { Authorization: `Bearer ${bru.getEnvVar("token")}` },
  });
  bru.setVar("configVersion", current.data.version);
}

body:json {
  {"expected_version": {{configVersion}}, "changes": {"weights.S": "0.99"}}
}

assert {
  res.status: eq 422
}

docs {
  Weights that do not sum to 1.0 answer 422 weights_sum_to_one (FRO-05). Reads the current version first.

  operationId: update_config
}
