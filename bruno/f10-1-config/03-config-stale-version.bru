meta {
  name: config-stale-version
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/config
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"expected_version": 0, "changes": {"dead_zone": "5"}}
}

assert {
  res.status: eq 409
}

docs {
  A stale expected_version answers 409 version_conflict (API-03).
}
