meta {
  name: comparison-summary
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/comparison/summary
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.reclassification_matrix.critical.critical: isNumber
}

docs {
  Raw vs processed: 4x4 matrix, funnel and indicators (D-039).

  operationId: get_comparison_summary
}
