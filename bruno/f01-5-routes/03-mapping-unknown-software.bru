meta {
  name: mapping-unknown-software
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/mappings/00000000-0000-0000-0000-000000000000
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"cpe": "cpe:2.3:a:f5:nginx:*:*:*:*:*:*:*:*"}
}

assert {
  res.status: eq 404
}

docs {
  Mapping an unknown software product answers 404. Manual flow: take a software id from pending/inventory and PUT its CPE.

  operationId: set_cpe_mapping
}
