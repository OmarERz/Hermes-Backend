meta {
  name: vulnerabilities-without-token-401
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/vulnerabilities
  body: none
  auth: none
}

assert {
  res.status: eq 401
  res.body.error.code: eq unauthorized
}

docs {
  A reader route without a bearer token.

  operationId: list_vulnerabilities
}
