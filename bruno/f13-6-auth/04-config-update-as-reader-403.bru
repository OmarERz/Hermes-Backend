meta {
  name: config-update-as-reader-403
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/config
  body: json
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

script:pre-request {
  const hermes = require("./lib/hermes");
  const api = (method, path, token, data) => hermes.api(bru, method, path, token, data);
  const current = await api("GET", "/api/config");
  bru.setVar("configVersion", current.version);  // the version check runs before the role check
}

body:json {
  {"expected_version": {{configVersion}}, "changes": {"source_health_hours": "6"}}
}

assert {
  res.status: eq 403
  res.body.error.code: eq forbidden
}

docs {
  A reader cannot change the configuration (analyst or admin per parameter).

  operationId: update_config
}
