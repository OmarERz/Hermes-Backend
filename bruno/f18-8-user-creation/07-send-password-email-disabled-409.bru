meta {
  name: send-password-email-disabled-409
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/admin/users/{{newUserUid}}/password-email
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  require("./lib/hermes").optIn(bru);
}

assert {
  res.status: eq 409
  res.body.error.code: eq user_disabled
}

docs {
  A switched-off account gets no e-mail until it is switched back on.

  operationId: send_password_email
}
