meta {
  name: create-user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  if (!require("./lib/hermes").optIn(bru)) return;
  // A new address every run (the test stack's Auth emulator keeps the e-mail instead of sending it).
  bru.setVar("newUserEmail", `bruno-${Date.now()}-${Math.floor(Math.random() * 1e6)}@example.com`);
}

body:json {
  {"email": "{{newUserEmail}}", "role": "reader"}
}

script:post-response {
  bru.setVar("newUserUid", res.body.uid);
}

assert {
  res.status: eq 201
  res.body.role: eq reader
  res.body.password_email_sent: eq true
}

tests {
  test("the account is created without a password and Firebase e-mails the link", function () {
    expect(res.body.email).to.equal(bru.getVar("newUserEmail"));
    expect(res.body.uid).to.be.a("string").and.not.be.empty;
    expect(res.body).to.not.have.property("password");
  });
}

docs {
  The admin creates an account with an e-mail and a role; Firebase e-mails the person a link to choose a password
  (D-105). Hermes never sees the password or the link.

  operationId: create_user
}
