meta {
  name: send-password-email
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/admin/users/{{newUserUid}}/password-email
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  require("./lib/hermes").optIn(bru);
}

assert {
  res.status: eq 200
  res.body.uid: eq {{newUserUid}}
  res.body.email: eq {{newUserEmail}}
}

docs {
  The e-mail to choose a password again: its link lasts one hour, or the first e-mail did not go out.

  operationId: send_password_email
}
