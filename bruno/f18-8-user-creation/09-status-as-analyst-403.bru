meta {
  name: status-as-analyst-403
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/admin/users/bruno-no-such-user/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{analystToken}}
}

body:json {
  {"disabled": true}
}

assert {
  res.status: eq 403
  res.body.error.code: eq forbidden
}

docs {
  Only an admin switches accounts off or on.

  operationId: set_user_status
}
