meta {
  name: password-email-as-reader-403
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/admin/users/bruno-no-such-user/password-email
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

assert {
  res.status: eq 403
  res.body.error.code: eq forbidden
}

docs {
  Only an admin sends the password e-mail.

  operationId: send_password_email
}
