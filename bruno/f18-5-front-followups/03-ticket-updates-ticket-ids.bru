meta {
  name: ticket-updates-ticket-ids
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/tickets/updates?limit=50
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

assert {
  res.status: eq 200
  res.body.items: isArray
}

tests {
  test("every log entry gives a ticket id the filters take, or null", function () {
    for (const entry of res.body.items) {
      const id = entry.ticket_itop_id;
      expect(id === null || /^[0-9]{1,12}$/.test(id)).to.equal(true);
    }
  });
}

docs {
  `ticket_itop_id` of a ticket log entry is the numeric iTop id its filter takes; null while the ticket is not in
  iTop or for a demo ticket (DEMO-n), which is still shown by `ticket_ref` (F18.5).

  operationId: list_ticket_updates
}
