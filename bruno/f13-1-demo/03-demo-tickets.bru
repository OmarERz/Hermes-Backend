meta {
  name: demo-tickets
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/tickets?limit=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.items.length: gte {{demoMinItems}}
}

docs {
  Tickets the ticket rules opened. Run `make demo` first; with `--env-var demoMinItems=1` every list must show data.

  operationId: list_tickets
}
