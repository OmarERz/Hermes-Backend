meta {
  name: demo-runs
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/runs?limit=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.items.length: gte {{demoMinItems}}
}

docs {
  The simulated scan run. Run `make demo` first; with `--env-var demoMinItems=1` every list must show data.

  operationId: list_runs
}
