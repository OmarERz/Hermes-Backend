meta {
  name: demo-recommendations
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/recommendations?limit=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.items.length: gte {{demoMinItems}}
}

docs {
  Assessments the demo cycle produced. Run `make demo` first; with `--env-var demoMinItems=1` every list must show data.

  operationId: list_recommendations
}
