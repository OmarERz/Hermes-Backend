meta {
  name: demo-alerts
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/alerts?limit=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.items.length: gte {{demoMinItems}}
}

docs {
  Alert for news about a product the CMDB holds. Run `make demo` first; with `--env-var demoMinItems=1` every list must show data.

  operationId: list_alerts
}
