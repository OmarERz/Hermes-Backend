meta {
  name: cpe-mapping
  type: http
  seq: 21
}

put {
  url: {{baseUrl}}/api/mappings/{{softwareId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  async function api(method, path, token, data) {
    const response = await bru.sendRequest({
      method,
      url: `${bru.getEnvVar("baseUrl")}${path}`,
      headers: { Authorization: `Bearer ${bru.getEnvVar(token || "token")}`, "Content-Type": "application/json" },
      data,
    });
    return response.data;
  }
  const pending = await api("GET", "/api/pending/inventory");
  const software = pending.software_without_cpe[0];
  if (!software) {
    bru.runner.skipRequest();  // every product is mapped: no route lists mapped software to edit
    return;
  }
  bru.setVar("softwareId", software.ci_id);  // for software the item id is the product id
}

body:json {
  {"cpe": "cpe:2.3:a:example:bruno_product:*:*:*:*:*:*:*:*"}
}

assert {
  res.status: eq 200
}

docs {
  Maps the first product without a CPE; skipped when every product is mapped.

  operationId: set_cpe_mapping
}
