meta {
  name: stix-export
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/stix/export
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  async function api(method, path, token, data) {
    const response = await bru.sendRequest({
      method,
      url: `${bru.getEnvVar("baseUrl")}${path}`,
      headers: { Authorization: `Bearer ${bru.getEnvVar(token || "token")}`, "Content-Type": "application/json" },
      data,
    });
    return response.data;
  }
  const page = await api("GET", "/api/vulnerabilities?limit=1");
  const group = page.groups[0];
  bru.setVar("groupId", group ? group.group_id : "");
  if (!group) {
    if (Number(bru.getEnvVar("demoMinItems") || 0) > 0) throw new Error("a vulnerability group expected with demo data");
    bru.runner.skipRequest();  // an installation without data: nothing to call this route on
    return;
  }
}

body:json {
  {"scope": "vulnerability", "vulnerability_id": "{{groupId}}", "exclude_ultra_classified": true}
}

assert {
  res.status: eq 200
  res.body.type: eq bundle
  res.body.objects: isArray
}

docs {
  STIX 2.1 bundle of one vulnerability group (STX-01), ultra-classified CIs left out.

  operationId: export_stix
}
