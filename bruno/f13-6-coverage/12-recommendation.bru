meta {
  name: recommendation
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/recommendations/{{assessmentId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  const hermes = require("./lib/hermes");
  const api = (method, path, token, data) => hermes.api(bru, method, path, token, data);
  const first = await hermes.recommendation(bru);
  if (!hermes.needData(bru, first, "a recommendation")) return;
}

assert {
  res.status: eq 200
  res.body.assessment_id: eq {{assessmentId}}
}

docs {
  A recommendation by its assessment id (FRO-09).

  operationId: get_recommendation
}
