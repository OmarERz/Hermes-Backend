meta {
  name: config-restore-current
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/config/versions/{{configVersion}}/restore
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  async function api(method, path, token, data) {
    const response = await bru.sendRequest({
      method,
      url: `${bru.getEnvVar("baseUrl")}${path}`,
      headers: { Authorization: `Bearer ${bru.getEnvVar(token || "token")}`, "Content-Type": "application/json" },
      data,
    });
    return response.data;
  }
  const current = await api("GET", "/api/config");
  bru.setVar("configVersion", current.version);
}

body:json {
  {"expected_version": {{configVersion}}}
}

assert {
  res.status: eq 200
  res.body.version: eq {{configVersion}}
}

docs {
  Restores the current version onto itself: nothing changes and no version is added (FRO-08).

  operationId: restore_config_version
}
