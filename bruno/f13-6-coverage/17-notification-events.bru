meta {
  name: notification-events
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/notifications/events?status=delivered&limit=5
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.items: isArray
}

docs {
  Delivered notification events (the demo's are delivered by the log consumer).

  operationId: list_notification_events
}
