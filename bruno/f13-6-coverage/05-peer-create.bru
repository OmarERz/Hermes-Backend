meta {
  name: peer-create
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/peer-companies
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  bru.setVar("peerName", `Bruno peer ${Date.now()}`);
}

body:json {
  {"name": "{{peerName}}", "sector": "retail", "country": "MX", "aliases": ["bruno"], "domain": null}
}

vars:post-response {
  peerId: res.body.id
}

assert {
  res.status: eq 201
  res.body.name: eq {{peerName}}
  res.body.id: isString
}

docs {
  A peer company with a name unique to this run; 06 and 07 update and delete it.

  operationId: create_peer_company
}
