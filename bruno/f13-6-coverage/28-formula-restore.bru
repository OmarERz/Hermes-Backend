meta {
  name: formula-restore
  type: http
  seq: 28
}

put {
  url: {{baseUrl}}/api/config
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  async function api(method, path, token, data) {
    const response = await bru.sendRequest({
      method,
      url: `${bru.getEnvVar("baseUrl")}${path}`,
      headers: { Authorization: `Bearer ${bru.getEnvVar(token || "token")}`, "Content-Type": "application/json" },
      data,
    });
    return response.data;
  }
  const current = await api("GET", "/api/config");
  bru.setVar("configVersion", current.version);
  bru.setVar("nextConfigVersion", current.version + 1);
}

body:json {
  {"expected_version": {{configVersion}}, "changes": {"formula.kev_exposed_floor": "{{kevFloorBefore}}"}}
}

assert {
  res.status: eq 200
  res.body.version: eq {{nextConfigVersion}}
}

docs {
  Puts back the KEV floor 26 changed, so a run leaves the formula as it found it (one more recalculation).

  operationId: update_config
}
