meta {
  name: setup-step-unchanged
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/setup/steps/3
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  const hermes = require("./lib/hermes");
  const api = (method, path, token, data) => hermes.api(bru, method, path, token, data);
  const steps = await api("GET", "/api/setup/status");
  const step = steps.find((s) => s.n === 3);
  bru.setVar("stepDone", step.done);
  bru.setVar("stepSkipped", step.skipped);
}

body:json {
  {"done": {{stepDone}}, "skipped": {{stepSkipped}}}
}

assert {
  res.status: eq 200
}

docs {
  Writes step 3 (peer companies) of the setup wizard back as it is.

  operationId: update_setup_step
}
