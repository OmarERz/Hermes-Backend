meta {
  name: formula-change
  type: http
  seq: 26
}

put {
  url: {{baseUrl}}/api/config
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  async function api(method, path, token, data) {
    const response = await bru.sendRequest({
      method,
      url: `${bru.getEnvVar("baseUrl")}${path}`,
      headers: { Authorization: `Bearer ${bru.getEnvVar(token || "token")}`, "Content-Type": "application/json" },
      data,
    });
    return response.data;
  }
  const current = await api("GET", "/api/config");
  bru.setVar("configVersion", current.version);
  bru.setVar("nextConfigVersion", current.version + 1);
  // A real formula change (an unchanged value creates no version): alternate the KEV floor between 90 and 91.
  bru.setVar("kevFloor", String(current.values["formula.kev_exposed_floor"]) === "90" ? "91" : "90");
}

body:json {
  {"expected_version": {{configVersion}}, "changes": {"formula.kev_exposed_floor": "{{kevFloor}}"}}
}

assert {
  res.status: eq 200
  res.body.version: eq {{nextConfigVersion}}
}

docs {
  Saving a formula change makes a new version and queues a recalculation run (FRO-08); 27 checks it.

  operationId: update_config
}
