meta {
  name: runs-filtered
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/runs?kind=scan&limit=5
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

assert {
  res.status: eq 200
  res.body.items: isArray
}

tests {
  test("every run is a scan", function () {
    for (const run of res.body.items) {
      expect(run.kind).to.equal("scan");
    }
  });
}

docs {
  Run list filtered by kind (HI-2); each run says why and by whom it was launched (HI-10).

  operationId: list_runs
}
