meta {
  name: connections-status
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/connections/status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.length: eq 6
}

docs {
  Connection checks: status, latency and a generic message; never a key (SEG-23).
}
