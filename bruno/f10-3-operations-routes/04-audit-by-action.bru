meta {
  name: audit-by-action
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/audit?action=setup.step&limit=5
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.items: isArray
}

docs {
  Audit trail filtered by action, newest first.
}
